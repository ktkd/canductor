{
 "name": "mazda_swap",
 "title": "CAN data collection: rx8/mx5",
 "version": "1.0",
 "cars": {
  "rx8": {
   "label": "Mazda RX-8 2008 (13B-MSP)"
  },
  "nd": {
   "label": "Mazda MX-5 ND 2019"
  }
 },
 "buses": {
  "hs": {
   "label": "HS-CAN 500 kbit/s",
   "can_baud": 500000,
   "std_only": true,
   "point": "OBD-II: pin 6 (CAN_H), pin 14 (CAN_L) — main bus of both vehicles"
  },
  "ms": {
   "label": "MS-CAN 125 kbit/s",
   "can_baud": 125000,
   "std_only": true,
   "point": "RX-8: OBD-II (confirm with diagram); ND: BCM pins 2F/2H — HVAC and body (chassis)"
  }
 },
 "rules": {
  "quiet_s": 5,
  "after_s": 5,
  "repeats": 3,
  "pause_s": 10,
  "action_min_s": 5,
  "action_max_s": 15,
  "state_max_s": 120
 },
 "warnings": [
  "Immobilizer MX-5 ND — without bypass/emulation, the engine will not start (critical).",
  "EPS — in the swap RE, EPS was not working: need to emulate the PCM signal or replace with hydraulic (critical).",
  "ABS/DSC — if the PCM signal is absent, they may be disabled: need to emulate torque (critical).",
  "RX-8 Series 1 (manual transmission) — via OBD-II, high rev limit is possible: disable OBD channels.",
  "Start/Stop Unit MX-5 ND — will not start without emulating the stock PCM: this is an independent authentication loop."
 ],
 "known_ids": {
  "rx8": [
   {
    "id": "0x201",
    "params": [
     {
      "name": "RPM",
      "bytes": "0-1 (BE)",
      "formula": "UINT16 * 0.25"
     },
     {
      "name": "Vehicle speed",
      "bytes": "4-5",
      "formula": "UINT16 / 100"
     },
     {
      "name": "TPS (accelerator)",
      "bytes": "6",
      "formula": "UINT8 / 2"
     }
    ]
   },
   {
    "id": "0x212",
    "params": [
     {
      "name": "Brake",
      "bytes": "5, 0x08",
      "formula": "Bool"
     },
     {
      "name": "Handbrake",
      "bytes": "4, 0x40",
      "formula": "Bool"
     }
    ]
   },
   {
    "id": "0x231",
    "params": [
     {
      "name": "Neutral",
      "bytes": "0, 0x80",
      "formula": "~Bool"
     }
    ]
   },
   {
    "id": "0x300",
    "params": [
     {
      "name": "Steering Warning Light",
      "bytes": "—",
      "formula": "Controlled"
     }
    ]
   },
   {
    "id": "0x420",
    "params": [
     {
      "name": "Coolant temperature",
      "bytes": "0",
      "formula": "UINT8 - 40"
     },
     {
      "name": "Fuel level",
      "bytes": "0-1",
      "formula": "confirm"
     }
    ]
   },
   {
    "id": "0x4B0",
    "params": [
     {
      "name": "Wheel speeds (4)",
      "bytes": "0,2,4,6",
      "formula": "UINT16 / 100 - 100"
     }
    ]
   }
  ],
  "nd": [
   {
    "id": "0x202",
    "params": [
     {
      "name": "RPM",
      "bytes": "0-1",
      "formula": "UINT16 / 4"
     },
     {
      "name": "Vehicle speed",
      "bytes": "2-3",
      "formula": "INT16 / 360"
     },
     {
      "name": "Accelerator",
      "bytes": "6",
      "formula": "UINT8 / 2.5"
     }
    ]
   },
   {
    "id": "0x78",
    "params": [
     {
      "name": "Brake",
      "bytes": "6",
      "formula": "min(max(E+if(E<=146,255,0)-156,0)/2.34,100)"
     }
    ]
   },
   {
    "id": "0x86",
    "params": [
     {
      "name": "Steering angle",
      "bytes": "0-1",
      "formula": "(16000 - UINT16) x 0.1"
     }
    ]
   },
   {
    "id": "0x09A",
    "params": [
     {
      "name": "Lighting state",
      "bytes": "0",
      "formula": "confirm"
     }
    ]
   },
   {
    "id": "0x165",
    "params": [
     {
      "name": "Gear state",
      "bytes": "13-14",
      "formula": "confirm"
     }
    ]
   },
   {
    "id": "0x720",
    "params": [
     {
      "name": "Instrument cluster (diagnostics)",
      "bytes": "—",
      "formula": "—"
     }
    ]
   },
   {
    "id": "0x40A",
    "params": [
     {
      "name": "",
      "bytes": "",
      "formula": ""
     }
    ]
   }
  ]
 },
