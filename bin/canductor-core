#!/usr/bin/env bash
# canductor-core — standalone core HTTP microservice, persistent base.
# Two adapters: HS (500k) and MS (125k). Default port 8111.
# Usage:  ./canductor-core [--port 8111]
#                DEV_HS=/dev/ttyUSB0 DEV_MS=/dev/ttyUSB1 ./canductor-core
set -euo pipefail
HOST="${HOST:-127.0.0.1}"
DEV_HS="${DEV_HS:-/dev/ttyUSB0}"
DEV_MS="${DEV_MS:-/dev/ttyUSB1}"
exec python3 -m canductor core \
     --host "$HOST" \
     --dev "hs=${DEV_HS}" \
     --dev "ms=${DEV_MS}" \
     "$@"